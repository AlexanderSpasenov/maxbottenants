# Application
APP_ENV=development
APP_NAME=maxbottenants
APP_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Europe/Moscow

# Database
POSTGRES_DB=maxbottenants
POSTGRES_USER=maxbot
POSTGRES_PASSWORD=maxbot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://maxbot:maxbot@postgres:5432/maxbottenants
DATABASE_URL_SYNC=postgresql+psycopg://maxbot:maxbot@postgres:5432/maxbottenants

# Redis
REDIS_URL=redis://redis:6379/0

# MAX Bot API (fill when real bot is available)
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_ENABLED=false

# Internal/admin
ADMIN_API_TOKEN=change-me
SYNC_INTERVAL_MINUTES=15

# Worker
WORKER_POLL_INTERVAL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=5
